import java.awt.BorderLayout;
import java.awt.CardLayout;
import java.awt.Dimension;
import java.awt.GridBagConstraints;
import java.awt.GridBagLayout;
import java.awt.Insets;
import java.util.LinkedHashMap;
import java.util.Map;
import javax.swing.BorderFactory;
import javax.swing.ButtonGroup;
import javax.swing.JButton;
import javax.swing.JComboBox;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JPanel;
import javax.swing.JRadioButton;
import javax.swing.JTextField;
import javax.swing.SwingUtilities;

/** Prática de ergonomia cognitiva em Java/Swing, sem persistência. */
public class ErgonomiaJava {
    private final JFrame frame = new JFrame("Ergonomia da interação — Java/Swing");
    private final CardLayout cards = new CardLayout();
    private final JPanel formCards = new JPanel(cards);
    private final JLabel instruction = new JLabel();
    private final JLabel status = new JLabel("Nenhuma tentativa registrada.");
    private final Map<String, JTextField> fieldsA = new LinkedHashMap<>();
    private final Map<String, JComboBox<String>> fieldsB = new LinkedHashMap<>();
    private String mode = "A";

    private ErgonomiaJava() {
        buildUi();
    }

    private void buildUi() {
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLayout(new BorderLayout(10, 10));
        JPanel toolbar = new JPanel();
        JRadioButton modeA = new JRadioButton("A — códigos", true);
        JRadioButton modeB = new JRadioButton("B — reconhecimento");
        ButtonGroup modes = new ButtonGroup();
        modes.add(modeA);
        modes.add(modeB);
        JButton interrupt = new JButton("Simular interrupção");
        toolbar.add(new JLabel("Condição:"));
        toolbar.add(modeA);
        toolbar.add(modeB);
        toolbar.add(interrupt);
        frame.add(toolbar, BorderLayout.NORTH);
        JPanel center = new JPanel(new BorderLayout(8, 8));
        center.setBorder(BorderFactory.createEmptyBorder(8, 18, 8, 18));
        center.add(instruction, BorderLayout.NORTH);
        formCards.add(buildFormA(), "A");
        formCards.add(buildFormB(), "B");
        center.add(formCards, BorderLayout.CENTER);
        JPanel actions = new JPanel();
        JButton confirm = new JButton("Confirmar registro");
        JButton clear = new JButton("Limpar");
        actions.add(confirm);
        actions.add(clear);
        center.add(actions, BorderLayout.SOUTH);
        frame.add(center, BorderLayout.CENTER);
        status.setBorder(BorderFactory.createEmptyBorder(8, 18, 14, 18));
        frame.add(status, BorderLayout.SOUTH);
        modeA.addActionListener(e -> showMode("A"));
        modeB.addActionListener(e -> showMode("B"));
        interrupt.addActionListener(e -> {
            status.setText("Interrupção: o telefone tocou. Conte até cinco e retome a tarefa.");
            interrupt.requestFocusInWindow();
        });
        confirm.addActionListener(e -> confirm());
        clear.addActionListener(e -> clear());
        showMode("A");
        frame.setMinimumSize(new Dimension(760, 520));
        frame.pack();
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);
    }

    private JPanel buildFormA() {
        JPanel panel = formPanel();
        addTextField(panel, fieldsA, 0, "predio", "1. Prédio/código");
        addTextField(panel, fieldsA, 1, "categoria", "2. Categoria/código");
        addTextField(panel, fieldsA, 2, "local", "3. Local/código");
        addTextField(panel, fieldsA, 3, "descricao", "4. Descrição");
        return panel;
    }

    private JPanel buildFormB() {
        JPanel panel = formPanel();
        addCombo(panel, 0, "predio", "1. Prédio", new String[]{"", "Prédio A", "Prédio B", "Prédio C"});
        addCombo(panel, 1, "categoria", "2. Categoria", new String[]{"", "Acessório", "Documento", "Eletrônico"});
        addCombo(panel, 2, "local", "3. Local", new String[]{"", "Armário 1", "Armário 2", "Armário 3"});
        JComboBox<String> description = new JComboBox<>(new String[]{"", "guarda-chuva azul", "mochila preta", "caderno vermelho"});
        fieldsB.put("descricao", description);
        addRow(panel, 3, "4. Descrição", description);
        return panel;
    }

    private JPanel formPanel() {
        JPanel panel = new JPanel(new GridBagLayout());
        panel.setBorder(BorderFactory.createTitledBorder("Registro interno"));
        return panel;
    }

    private void addTextField(JPanel panel, Map<String, JTextField> map, int row, String key, String label) {
        JTextField field = new JTextField(24);
        map.put(key, field);
        addRow(panel, row, label, field);
    }

    private void addCombo(JPanel panel, int row, String key, String label, String[] values) {
        JComboBox<String> combo = new JComboBox<>(values);
        fieldsB.put(key, combo);
        addRow(panel, row, label, combo);
    }

    private void addRow(JPanel panel, int row, String label, java.awt.Component component) {
        GridBagConstraints c = new GridBagConstraints();
        c.insets = new Insets(8, 8, 8, 8);
        c.gridy = row;
        c.gridx = 0;
        c.anchor = GridBagConstraints.LINE_START;
        panel.add(new JLabel(label), c);
        c.gridx = 1;
        c.weightx = 1;
        c.fill = GridBagConstraints.HORIZONTAL;
        panel.add(component, c);
    }

    private void showMode(String nextMode) {
        mode = nextMode;
        cards.show(formCards, mode);
        instruction.setText(mode.equals("A")
            ? "Memorize: prédio B = 74; acessório = K; armário 3 = 19. Registre um guarda-chuva azul."
            : "Use opções reconhecíveis e preserve o estado após a interrupção.");
        status.setText("Condição alterada. Comece uma nova observação.");
        if (mode.equals("A")) fieldsA.get("predio").requestFocusInWindow();
        else fieldsB.get("predio").requestFocusInWindow();
    }

    private Map<String, String> values() {
        Map<String, String> result = new LinkedHashMap<>();
        if (mode.equals("A")) fieldsA.forEach((k, v) -> result.put(k, v.getText()));
        else fieldsB.forEach((k, v) -> result.put(k, String.valueOf(v.getSelectedItem())));
        return result;
    }

    static String validateRecord(Map<String, String> values, String mode) {
        String[][] expected = mode.equals("A")
            ? new String[][]{{"predio", "74"}, {"categoria", "K"}, {"local", "19"}, {"descricao", "guarda-chuva azul"}}
            : new String[][]{{"predio", "Prédio B"}, {"categoria", "Acessório"}, {"local", "Armário 3"}, {"descricao", "guarda-chuva azul"}};
        for (String[] item : expected) {
            String actual = values.getOrDefault(item[0], "").trim();
            if (actual.isEmpty()) return "INCOMPLETE:" + item[0];
            if (!actual.equalsIgnoreCase(item[1])) return "REVIEW:" + item[0];
        }
        return "OK";
    }

    private static void smokeTest() {
        Map<String, String> validA = Map.of(
            "predio", "74", "categoria", "K", "local", "19", "descricao", "guarda-chuva azul");
        Map<String, String> validB = Map.of(
            "predio", "Prédio B", "categoria", "Acessório", "local", "Armário 3", "descricao", "guarda-chuva azul");
        if (!validateRecord(validA, "A").equals("OK")) throw new AssertionError("valid A");
        if (!validateRecord(validB, "B").equals("OK")) throw new AssertionError("valid B");
        if (!validateRecord(Map.of("predio", ""), "A").equals("INCOMPLETE:predio")) {
            throw new AssertionError("missing field");
        }
        Map<String, String> wrong = new LinkedHashMap<>(validB);
        wrong.put("predio", "Prédio A");
        if (!validateRecord(wrong, "B").equals("REVIEW:predio")) throw new AssertionError("wrong building");
        System.out.println("JAVA_SMOKE_PASS");
    }

    private void confirm() {
        String result = validateRecord(values(), mode);
        if (result.equals("OK")) {
            status.setText("Registro fictício concluído. Confira prédio e armário; nada foi salvo.");
        } else {
            String field = result.substring(result.indexOf(':') + 1);
            status.setText("Revise " + field + "; os demais dados foram preservados.");
            if (mode.equals("A")) fieldsA.get(field).requestFocusInWindow();
            else fieldsB.get(field).requestFocusInWindow();
        }
    }

    private void clear() {
        fieldsA.values().forEach(field -> field.setText(""));
        fieldsB.values().forEach(combo -> combo.setSelectedIndex(0));
        status.setText("Campos limpos; nenhuma informação foi persistida.");
    }

    public static void main(String[] args) {
        if (args.length > 0 && args[0].equals("--smoke-test")) {
            smokeTest();
        } else {
            SwingUtilities.invokeLater(ErgonomiaJava::new);
        }
    }
}